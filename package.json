{
  "name": "n8n-nodes-zep-v3",
  "version": "0.1.5",
  "description": "Community nodes: Zep Memory (v3) & Zep Vector Store (v3)",
  "keywords": [
    "n8n-community-node-package",
    "zep",
    "memory",
    "vector-store",
    "ai",
    "langchain"
  ],
  "author": {
    "name": "Fabio Henrique",
    "email": "fabiohsan@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fabiohsan/n8n-nodes-zep-v3.git"
  },
  "bugs": {
    "url": "https://github.com/fabiohsan/n8n-nodes-zep-v3/issues"
  },
  "homepage": "https://github.com/fabiohsan/n8n-nodes-zep-v3#readme",
  "license": "MIT",
  "main": "index.js",
  "engines": {
    "node": ">=18.10.0"
  },
  "files": [
    "index.js",
    "dist/**/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && npm run copy-icons",
    "copy-icons": "cp nodes/ZepMemory/zep-logo.png dist/nodes/ZepMemory/ && cp nodes/ZepVectorStore/zep-logo.png dist/nodes/ZepVectorStore/",
    "watch": "tsc -w -p tsconfig.build.json",
    "lint": "eslint nodes credentials --ext .ts"
  },
  "peerDependencies": {
    "n8n-workflow": "*",
    "n8n-core": "*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "ts-node": "^10.9.2",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.0"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/ZepApiV3.credentials.js"
    ],
    "nodes": [
      "dist/nodes/ZepMemory/ZepMemory.node.js",
      "dist/nodes/ZepVectorStore/ZepVectorStore.node.js"
    ]
  }
}
